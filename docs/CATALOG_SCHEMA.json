{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HakkinCatalogManifestV2",
  "type": "object",
  "required": ["version", "catalog_timestamp", "apps"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Versión del esquema de especificación del catálogo (2.0.0)"
    },
    "catalog_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "launcher_meta": {
      "type": "object",
      "properties": {
        "latest_version": { "type": "string" },
        "min_required_launcher_version": { "type": "string" },
        "releases": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["url", "sha256"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "sha256": { "type": "string" },
              "size_bytes": { "type": "integer" }
            }
          }
        }
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "latest_version", "platforms"],
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "category": { "type": "string", "enum": ["game", "app", "tool"] },
          "developer": { "type": "string" },
          "summary": { "type": "string" },
          "description_markdown": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "assets": {
            "type": "object",
            "properties": {
              "icon": { "type": ["string", "null"] },
              "poster": { "type": ["string", "null"] },
              "banner": { "type": ["string", "null"] },
              "screenshots": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "latest_version": { "type": "string" },
          "platforms": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["latest_version", "versions"],
              "properties": {
                "latest_version": { "type": "string" },
                "protected_user_paths": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "versions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["version", "package"],
                    "anyOf": [
                      { "required": ["entry_point"] },
                      { "required": ["executable_relative_path"] }
                    ],
                    "properties": {
                      "version": { "type": "string" },
                      "release_date": { "type": ["string", "null"] },
                      "changelog": { "type": "string" },
                      "entry_point": { "type": "string" },
                      "executable_relative_path": { "type": "string" },
                      "package": {
                        "type": "object",
                        "required": ["url", "sha256", "size_bytes"],
                        "properties": {
                          "url": { "type": "string", "format": "uri" },
                          "size_bytes": { "type": "integer" },
                          "sha256": { "type": "string" }
                        }
                      },
                      "delta_patches": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["from_version", "patch_format", "url", "patch_sha256", "target_sha256"],
                          "properties": {
                            "from_version": { "type": "string" },
                            "patch_format": { "type": "string", "enum": ["hdiff", "bsdiff"] },
                            "url": { "type": "string", "format": "uri" },
                            "size_bytes": { "type": "integer" },
                            "patch_sha256": { "type": "string" },
                            "target_sha256": { "type": "string" }
                          }
                        }
                      },
                      "scripts": {
                        "type": "object",
                        "properties": {
                          "pre_install": { "type": ["string", "null"] },
                          "post_install": { "type": ["string", "null"] }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
